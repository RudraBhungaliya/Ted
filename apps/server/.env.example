# Ted Platform Server Configuration (Fastify)
PORT=4000
NODE_ENV=development

# Database (PostgreSQL - matches docker-compose.yml)
DATABASE_URL=postgresql://rudra:qwerty@localhost:5432/ted

# Redis Cache & Realtime PubSub
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_ted_dev_2026_change_in_prod

# AI Model Keys
GEMINI_API_KEY=your_gemini_api_key_here
XAI_API_KEY=your_grok_xai_api_key_here
XAI_API_BASE_URL=https://api.x.ai/v1

# Realtime Speech-to-Text (Deepgram)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# OAuth Authentication (Google)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
CLIENT_REDIRECT_URL=http://localhost:3000

# Pipeline Latency & Model Tuning
AI_RESPONSE_DEBOUNCE_MS=120
DEEPGRAM_ENDPOINTING_MS=160
AI_MAX_HISTORY_TURNS=8

